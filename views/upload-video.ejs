<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Video</title>
</head>
<body>
    <h1>Upload Video</h1>
    <form action="/admin/upload-video" method="POST" enctype="multipart/form-data">
        <label for="topicId">Select Topic:</label>
        <select name="topicId" id="topicId" required>
            <% topics.forEach(topic => { %>
                <option value="<%= topic._id %>"><%= topic.name %></option>
            <% }) %>
        </select><br><br>

        <label for="name">Video Name:</label>
        <input type="text" name="name" id="name" required><br><br>

        <label for="tag">Video Tag:</label>
        <select name="tag" id="tag" required>
            <option value="beginner">Beginner</option>
            <option value="intermediate">Intermediate</option>
            <option value="advanced">Advanced</option>
        </select><br><br>

        <label for="video">Upload Video:</label>
        <input type="file" name="video" id="video" accept="video/*" required><br><br>

        <button type="submit">Upload</button>
    </form>
</body>
</html>